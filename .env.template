# ===============================================
# SOLANA TRADING BOT - CONFIGURATION
# ===============================================
# WICHTIG: Kopiere diese Datei zu ".env" und fülle alle Werte aus!
# cp .env.template .env

# ===============================================
# TELEGRAM BOT
# ===============================================
# Dein Telegram Bot Token von @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Deine Telegram Chat ID (für Alerts)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===============================================
# SOLANA WALLET
# ===============================================
# Dein Solana Wallet Private Key (Base58 encoded)
# ACHTUNG: Niemals teilen! Niemals in Git committen!
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Dein Solana Wallet Public Key (optional, wird aus Private Key abgeleitet)
WALLET_PUBLIC_KEY=your_wallet_public_key_here

# ===============================================
# SOLANA RPC
# ===============================================
# Helius RPC (empfohlen für beste Performance)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=d41f7804-f0da-406e-9d84-253cfd1c0f57
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=d41f7804-f0da-406e-9d84-253cfd1c0f57

# WebSocket RPC (für Echtzeit-Updates)
WEBSOCKET_RPC_URL=wss://mainnet.helius-rpc.com/?api-key=d41f7804-f0da-406e-9d84-253cfd1c0f57

# Backup RPC (fallback)
BACKUP_RPC_URL=https://api.mainnet-beta.solana.com

# ===============================================
# API KEYS (Optional)
# ===============================================
# DexScreener API (optional)
DEXSCREENER_API_KEY=

# Birdeye API (optional)
BIRDEYE_API_KEY=

# ===============================================
# TRADING CONFIGURATION
# ===============================================
# Automatischer Trading-Modus (true/false)
AUTO_TRADE=false

# Minimum Investment pro Trade (in SOL)
MIN_TRADE_AMOUNT=0.05

# Maximum Investment pro Trade (in SOL)
MAX_TRADE_AMOUNT=0.5

# ===============================================
# SAFETY & LIMITS
# ===============================================
# Maximum gleichzeitige Positionen
MAX_POSITIONS=5

# Daily Loss Limit (in SOL)
DAILY_LOSS_LIMIT=2.0

# Stop Trading bei diesem Loss
STOP_LOSS_PERCENT=15

# ===============================================
# ADVANCED
# ===============================================
# Enable Debug Logging (true/false)
DEBUG=false

# Enable Sniping Mode (ultra-fast)
ENABLE_SNIPING=true

# Database Path
DATABASE_PATH=trades.db
