### ISSUE #11: No Retry Logic for Critical Operations

**Location:** `trader.py`, `analyzer.py`  
**Severity:** 🟢 **MEDIUM**  
**Impact:** Transient failures cause missed opportunities

**Solution:**
```python
# Create retry.py

import asyncio
import logging
from functools import wraps
from typing import TypeVar, Callable, Any, Optional, Tuple, Type

logger = logging.getLogger(__name__)

T = TypeVar('T')

async def retry_async(
    func: Callable[..., T],
    max_attempts: int = 3,
    delay: float = 1.0,
    backoff: float = 2.0,
    exceptions: Tuple[Type[Exception], ...] = (Exception,),
    on_retry: Optional[Callable[[Exception, int], None]] = None
) -> T:
    """
    Retry async function with exponential backoff
    
    Args:
        func: Async function to retry
        max_attempts: Maximum retry attempts
        delay: Initial delay between retries (seconds)
        backoff: Backoff multiplier
        exceptions: Tuple of exceptions to catch
        on_retry: Callback function(exception, attempt_number)
    """
    attempt = 0
    current_delay = delay
    
    while attempt < max_attempts:
        try:
            return await func()
        except exceptions as e:
            attempt += 1
            
            if attempt >= max_attempts:
                logger.error(f"Max retries ({max_attempts}) exceeded for {func.__name__}")
                raise
            
            if on_retry:
                on_retry(e, attempt)
            else:
                logger.warning(
                    f"Retry {attempt}/{max_attempts} for {func.__name__} after {e}"
                )
            
            await asyncio.sleep(current_delay)
            current_delay *= backoff

def retry(max_attempts: int = 3, delay: float = 1.0, 
         backoff: float = 2.0, 
         exceptions: Tuple[Type[Exception], ...] = (Exception,)):
    """Decorator for retry logic"""
    def decorator(func):
        @wraps(func)
        async def wrapper(*args, **kwargs):
            async def _func():
                return await func(*args, **kwargs)
            
            return await retry_async(
                _func,
                max_attempts=max_attempts,
                delay=delay,
                backoff=backoff,
                exceptions=exceptions
            )
        return wrapper
    return decorator

# Usage in trader.py:
from retry import retry
import aiohttp

@retry(
    max_attempts=3,
    delay=0.5,
    backoff=2.0,
    exceptions=(aiohttp.ClientError, asyncio.TimeoutError)
)
async def _fetch_jupiter_quote(self, input_mint: str, output_mint: str, 
                               amount: int) -> Dict:
    """Fetch Jupiter quote with retry"""
    async with self.session.get(
        JUPITER_QUOTE_API,
        params={
            'inputMint': input_mint,
            'outputMint': output_mint,
            'amount': amount
        }
    ) as response:
        response.raise_for_status()
        return await response.json()

# Usage in analyzer.py:
@retry(max_attempts=2, delay=1.0)
async def _fetch_token_metadata(self, token_address: str) -> Optional[Dict]:
    """Fetch metadata with retry"""
    # ... fetch logic ...
```

