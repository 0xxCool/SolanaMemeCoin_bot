### ISSUE #12: Missing Health Check for Components

**Location:** `health.py` needs enhancement  
**Severity:** 🟢 **MEDIUM**  
**Impact:** No visibility into component health

**Solution:**
```python
# Enhance health.py

import time
from typing import Dict, Optional
from dataclasses import dataclass, asdict
from enum import Enum
import asyncio

class HealthStatus(Enum):
    HEALTHY = "healthy"
    DEGRADED = "degraded"
    UNHEALTHY = "unhealthy"

@dataclass
class ComponentHealth:
    """Health status for a component"""
    status: HealthStatus
    last_check: float
    last_success: float
    failure_count: int = 0
    error_message: Optional[str] = None
    metrics: Dict = None
    
    def to_dict(self) -> Dict:
        d = asdict(self)
        d['status'] = self.status.value
        return d

class HealthChecker:
    """Enhanced health checker"""
    
    def __init__(self):
        self.components: Dict[str, ComponentHealth] = {}
        self.start_time = time.time()
        self.lock = asyncio.Lock()
    
    async def register_component(self, name: str):
        """Register a component for health checking"""
        async with self.lock:
            self.components[name] = ComponentHealth(
                status=HealthStatus.HEALTHY,
                last_check=time.time(),
                last_success=time.time(),
                metrics={}
            )
    
    async def update_status(self, name: str, status: HealthStatus, 
                          error: Optional[str] = None, 
                          metrics: Optional[Dict] = None):
        """Update component health status"""
        async with self.lock:
            if name not in self.components:
                await self.register_component(name)
            
            comp = self.components[name]
            comp.last_check = time.time()
            comp.status = status
            
            if status == HealthStatus.HEALTHY:
                comp.last_success = time.time()
                comp.failure_count = 0
                comp.error_message = None
            else:
                comp.failure_count += 1
                comp.error_message = error
            
            if metrics:
                comp.metrics.update(metrics)
    
    async def record_success(self, name: str, metrics: Optional[Dict] = None):
        """Record successful operation"""
        await self.update_status(name, HealthStatus.HEALTHY, metrics=metrics)
    
    async def record_failure(self, name: str, error: str):
        """Record failed operation"""
        async with self.lock:
            if name in self.components:
                comp = self.components[name]
                
                # Determine status based on failure count
                if comp.failure_count >= 5:
                    status = HealthStatus.UNHEALTHY
                elif comp.failure_count >= 2:
                    status = HealthStatus.DEGRADED
                else:
                    status = HealthStatus.HEALTHY
                
                await self.update_status(name, status, error)
    
    async def get_overall_health(self) -> Dict:
        """Get overall system health"""
        async with self.lock:
            # Determine overall status
            statuses = [c.status for c in self.components.values()]
            
            if any(s == HealthStatus.UNHEALTHY for s in statuses):
                overall = HealthStatus.UNHEALTHY
            elif any(s == HealthStatus.DEGRADED for s in statuses):
                overall = HealthStatus.DEGRADED
            else:
                overall = HealthStatus.HEALTHY
            
            return {
                'status': overall.value,
                'uptime_seconds': time.time() - self.start_time,
                'components': {
                    name: comp.to_dict() 
                    for name, comp in self.components.items()
                },
                'timestamp': time.time()
            }

# Global instance
health_checker = HealthChecker()

# Usage in scanner.py:
from health import health_checker, HealthStatus

async def _websocket_loop(self):
    """WebSocket loop with health checks"""
    while self.running:
        try:
            async with websockets.connect(...) as websocket:
                # ✅ Report healthy
                await health_checker.record_success(
                    'scanner',
                    metrics={'queue_size': self.processing_queue.qsize()}
                )
                
                async for message in websocket:
                    # ... processing ...
                    pass
                    
        except Exception as e:
            # ✅ Report failure
            await health_checker.record_failure('scanner', str(e))
            logger.error(f"WebSocket error: {e}")

# Usage in trader.py:
async def execute_trade(self, ...):
    """Execute trade with health tracking"""
    try:
        # ... trade logic ...
        
        # ✅ Report success
        await health_checker.record_success(
            'trader',
            metrics={
                'active_positions': len(self.positions),
                'last_trade_time': time.time()
            }
        )
        
    except Exception as e:
        # ✅ Report failure
        await health_checker.record_failure('trader', str(e))
        raise
```

